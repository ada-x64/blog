/// <reference types="node" />

// Convert themes from a Zed theme family JSON into .tmTheme files for Typst's
// `raw(theme: ...)`.
//
// Usage: bun run scripts/zed-to-tmtheme.mts <zed.json> [theme name] [out]
// With no theme name, every theme in the family is converted. `out` defaults
// to src/typst/assets/<theme name, slugified>.tmTheme.

import { promises as fs } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

type SyntaxStyle = {
	color?: string | null;
	font_style?: string | null;
	font_weight?: number | null;
};
type ZedTheme = {
	name: string;
	style: Record<string, unknown> & {
		players: { cursor: string; selection: string }[];
		syntax: Record<string, SyntaxStyle>;
	};
};

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

// Zed syntax key -> TextMate scopes.
const mapping: [string, string][] = [
	["comment", "comment, punctuation.definition.comment"],
	["punctuation", "punctuation"],
	[
		"punctuation.special",
		"punctuation.section.embedded, punctuation.definition.template-expression",
	],
	[
		"punctuation.list_marker",
		"punctuation.definition.list, markup.list punctuation.definition",
	],
	["keyword", "keyword, storage, storage.type, storage.modifier"],
	["operator", "keyword.operator"],
	["string", "string, punctuation.definition.string"],
	["string.escape", "constant.character.escape"],
	["string.regex", "string.regexp"],
	["string.special.symbol", "constant.other.symbol"],
	["number", "constant.numeric"],
	["boolean", "constant.language.boolean"],
	["constant", "constant, support.constant, constant.language"],
	["enum", "entity.name.enum"],
	["variant", "variable.other.enummember, constant.other.enum"],
	[
		"function",
		"entity.name.function, support.function, variable.function, meta.function-call.identifier",
	],
	[
		"constructor",
		"entity.name.function.constructor, meta.function-call.constructor",
	],
	[
		"preproc",
		"meta.preprocessor, keyword.directive, support.macro, entity.name.macro",
	],
	["attribute", "entity.other.attribute-name, meta.attribute, meta.annotation"],
	[
		"type",
		"entity.name.type, entity.name.class, entity.name.struct, entity.name.trait, support.type, support.class, entity.other.inherited-class, entity.name.namespace",
	],
	["variable", "variable, variable.parameter"],
	["variable.special", "variable.language"],
	[
		"property",
		"variable.other.member, variable.other.property, meta.property-name, support.type.property-name",
	],
	["label", "entity.name.label"],
	["tag", "entity.name.tag"],
	["title", "markup.heading, entity.name.section"],
	["emphasis", "markup.italic"],
	["emphasis.strong", "markup.bold"],
	["link_text", "string.other.link, meta.link"],
	["link_uri", "markup.underline.link"],
	["text.literal", "markup.raw"],
];

const [src, name, outArg] = process.argv.slice(2);
if (!src) {
	console.error(
		"Usage: bun run scripts/zed-to-tmtheme.mts <zed.json> [theme name] [out]",
	);
	process.exit(1);
}

const family = JSON.parse(await fs.readFile(src, "utf8")) as {
	themes: ZedTheme[];
};

const fontStyle = (s: SyntaxStyle) =>
	[
		s.font_style === "italic" ? "italic" : "",
		(s.font_weight ?? 0) >= 700 ? "bold" : "",
	]
		.filter(Boolean)
		.join(" ");

const escapeXml = (s: string) =>
	s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const dict = (pairs: [string, string][], indent: number) => {
	const p = "\t".repeat(indent);
	return pairs
		.map(
			([k, v]) => `${p}<key>${k}</key>\n${p}<string>${escapeXml(v)}</string>`,
		)
		.join("\n");
};

const toTmTheme = ({ name, style }: ZedTheme) => {
	const str = (key: string) => style[key] as string;

	const rules: [string, string, string, string][] = mapping
		.filter(([key]) => style.syntax[key]?.color)
		.map(([key, scope]) => [
			key,
			scope,
			style.syntax[key].color as string,
			fontStyle(style.syntax[key]),
		]);
	rules.push(
		["diff inserted", "markup.inserted", str("created"), ""],
		["diff deleted", "markup.deleted", str("deleted"), ""],
		["diff changed", "markup.changed", str("modified"), ""],
		["invalid", "invalid", str("error"), "underline"],
	);

	const out = [
		'<?xml version="1.0" encoding="UTF-8"?>',
		'<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
		`<!-- ${escapeXml(name)}, generated by scripts/zed-to-tmtheme.mts. -->`,
		'<plist version="1.0">',
		"<dict>",
		dict([["name", name]], 1),
		"\t<key>settings</key>",
		"\t<array>",
		"\t\t<dict>",
		"\t\t\t<key>settings</key>",
		"\t\t\t<dict>",
		dict(
			[
				["foreground", str("editor.foreground")],
				["background", str("editor.background")],
				["caret", style.players[0].cursor],
				["selection", style.players[0].selection],
				["lineHighlight", str("editor.active_line.background")],
				["invisibles", str("editor.invisible")],
			],
			4,
		),
		"\t\t\t</dict>",
		"\t\t</dict>",
	];
	for (const [ruleName, scope, color, fs] of rules) {
		const settings: [string, string][] = [["foreground", color]];
		if (fs) settings.push(["fontStyle", fs]);
		out.push(
			"\t\t<dict>",
			dict(
				[
					["name", ruleName],
					["scope", scope],
				],
				3,
			),
			"\t\t\t<key>settings</key>",
			"\t\t\t<dict>",
			dict(settings, 4),
			"\t\t\t</dict>",
			"\t\t</dict>",
		);
	}
	out.push("\t</array>", "</dict>", "</plist>", "");
	return out.join("\n");
};

const slugify = (s: string) =>
	s
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "");

const themes = name
	? family.themes.filter((t) => t.name === name)
	: family.themes;
if (themes.length === 0) {
	console.error(`No theme named "${name}". Available:`);
	for (const t of family.themes) console.error(`- ${t.name}`);
	process.exit(1);
}

for (const theme of themes) {
	const outPath =
		(name && outArg) ||
		path.join(root, "src", "typst", "assets", `${slugify(theme.name)}.tmTheme`);
	await fs.writeFile(outPath, toTmTheme(theme));
	console.log(`wrote ${path.relative(process.cwd(), outPath)}`);
}
